# Copy this file to .env and fill in real values.
# NOTE: .env is gitignored (contains secrets) — do NOT commit it.
# The compose file already hardcodes local DB/JWT so `docker compose up -d`
# works out-of-the-box. This file only supplies optional external services.

# Google (server-side OAuth) — optional
GOOGLE_CLIENTID=

# Email — optional (leave blank to disable)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Cloudinary — optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayOS — optional
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5267/api/payment/payos-return
PAYOS_CANCEL_URL=http://localhost:5267/api/payment/payos-cancel
